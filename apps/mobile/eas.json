{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "https://market-api.minifygadgets.com/api" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://market-api.minifygadgets.com/api" }
    },
    "production": {
      "env": { "EXPO_PUBLIC_API_URL": "https://market-api.minifygadgets.com/api" },
      "autoIncrement": true
    }
  }
}
